[worldserver]
# ==============================================================================
# MÓDULO: FORMAS DE DRUIDA GENERALES
# ==============================================================================
# IgnoreFaction
#        0 - (Por defecto) Muestra formas exclusivas según la facción del jugador.
#        1 - Muestra todas las formas disponibles a todos los jugadores.
DruidForms.IgnoreFaction = 0

# ==============================================================================
# CONFIGURACIÓN DE MODELOS
# Formato: "ID:Nombre, ID2:Nombre2"
# Nota: Usa el ID 0 para mantener la forma racial natural (Sin transformación).
# ==============================================================================

