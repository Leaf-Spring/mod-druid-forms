DruidForms.travel.Both = "918:Amarillo con Motas Negras, 14318:Azul Oscuro con Motas Blancas, 6805:Cafe con Rayas Grises, 598:Naranja con Rayas Negras, 954:Blanco con Motas Negras, 2437:Azul Oscuro, 11449:Azul Oscuro con Rayas blancas, 1059:Dorado, 161:Lobo Café, 165:Lobo Gris, 780:Lobo Negro, 802:Lobo Blanco"
